    E --> F["**Uncertainty Estimator**\nu(x) = σ(x) / μ(x)"]
    F --> G["**Drift Detector**\nPage-Hinkley Test  δ=0.005  λ=25"]
    G --> H{"`**SAGE Controller**\nadapt / gather / fallback`"}
    H --> I["**Execution Layer**\nmysql-connector-python"]
    I --> J[("**MySQL 8.0**")]
    J --> K["**Feedback Collector**\nUpdates training buffer"]
    K --> E
    J --> L(["`**Results**`"])
    K --> M["**Dashboard**\nStreamlit"]

