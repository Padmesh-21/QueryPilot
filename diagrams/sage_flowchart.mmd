flowchart TD
    A([Start]) --> B[Generate Candidates\n& Extract Features]
    B --> C{Model trained\n& n ≥ 10?}
    C -- No --> D[GATHER EVIDENCE\nRun native SQL]
    C -- Yes --> E{Drift\nDetected?}
    E -- Yes --> F[FALLBACK\nClear buffer]
    E -- No --> G{Valid candidate\npasses filters?}
    G -- No --> H[FALLBACK\nNo valid candidate]
    G -- Yes --> I[ADAPT\nRun best candidate]
    D --> J[Record time\nUpdate model]
    F --> J
    H --> J
    I --> J
    J --> K([Return Results])

    style D fill:#4a90d9,stroke:#357abd,color:#fff
    style F fill:#e74c3c,stroke:#c0392b,color:#fff
    style H fill:#e74c3c,stroke:#c0392b,color:#fff
    style I fill:#27ae60,stroke:#1e8449,color:#fff
    style A fill:#f5a623,stroke:#e09415,color:#000
    style K fill:#f5a623,stroke:#e09415,color:#000
